NODE_ENV=production
PORT=4000
APP_ORIGIN=https://your-domain.com
TRUST_PROXY=true
JWT_SECRET=replace-with-at-least-32-random-characters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vyavas
MYSQL_USER=vyavas
MYSQL_PASSWORD=replace-me
SCAN_CONCURRENCY=12
MAX_IMPORT_ROWS=1000000
SMTP_PROVIDER=hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@your-domain.com
